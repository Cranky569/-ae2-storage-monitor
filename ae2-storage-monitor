-- me_bridge_all_cells.lua
-- Zeigt alle Cells auf dem Monitor mit Partition-Status

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w,h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1,cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1,cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

monPrint("=== ME BRIDGE CELLS ===")

-- Alle Cells abrufen
if bridge.getCells then
    local ok, cells = pcall(bridge.getCells, bridge)
    if ok and type(cells) == "table" then
        local index = 1
        for _, cell in ipairs(cells) do
            local ctype = cell.cellType or cell.type or cell["cell_type"] or "unknown"
            local name = cell.item or cell.name or "nil"
            local partitioned = cell.isPartitioned or cell.partitioned or false
            local precise = cell.isPrecise or cell.precise or false
            local includedPrecise = cell.isIncludedPrecise or cell.includePrecise or false
            local excluded = cell.isExcluded or cell.excluded or false

            monPrint(string.format("Cell #%d: %s (Type=%s)", index, name, ctype))
            monPrint(string.format("Flags: Partitioned=%s | Precise=%s | IncludedPrecise=%s | Excluded=%s",
                tostring(partitioned), tostring(precise), tostring(includedPrecise), tostring(excluded)
            ))
            monPrint("----------------------------")
            index = index + 1
        end
        if index == 1 then
            monPrint("Keine Cells gefunden.")
        end
    else
        monPrint("Fehler beim Abrufen der Cells: " .. tostring(cells))
    end
else
    monPrint("getCells() nicht verfügbar auf diesem Bridge.")
end
