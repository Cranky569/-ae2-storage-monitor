-- me_bridge_fluid_storage_debug.lua
-- Zeigt alle Infos von getFluidStorage() auf dem Monitor, ohne Berechnung

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w, h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1, cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1, cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Fluid Storage abrufen
local ok, usedFluids = pcall(bridge.getUsedFluidStorage, bridge)
local ok2, maxFluids = pcall(bridge.getTotalFluidStorage, bridge)

monPrint("=== Fluid Storage Debug ===")
if ok then
    monPrint("Used Fluid Storage: " .. tostring(usedFluids))
else
    monPrint("Fehler beim Abrufen von UsedFluidStorage: " .. tostring(usedFluids))
end

if ok2 then
    monPrint("Total Fluid Storage: " .. tostring(maxFluids))
else
    monPrint("Fehler beim Abrufen von TotalFluidStorage: " .. tostring(maxFluids))
end
