-- me_bridge_storage_monitor.lua
-- Zeigt Items, Fluids und Chemicals von der ME Bridge auf dem Monitor an
-- Free Storage ignoriert nur Included Precise Zellen
-- Partitioned/Excluded werden weiterhin gezählt

local monitor = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not monitor then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    monitor.clear()
    monitor.setCursorPos(1,1)
    monitor.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
monitor.clear()
monitor.setBackgroundColor(colors.black)
monitor.setTextColor(colors.white)
monitor.setTextScale(1)
local w,h = monitor.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        monitor.scroll(1)
        cursorY = h
        monitor.setCursorPos(1,cursorY)
        monitor.clearLine()
    end
    monitor.setCursorPos(1,cursorY)
    monitor.write(text)
    cursorY = cursorY + 1
end

-- Formatierte Bytes
local function formatBytes(bytes)
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

-- Typen: item / fluid / chemical
local types = {"item", "fluid", "chemical"}

-- Funktion: Storage für Typ berechnen
local function processStorage(cellType)
    local usedTotal, freeTotal = 0, 0
    local usedFunc, totalFunc

    if cellType == "item" then
        usedFunc = bridge.getUsedItemStorage
        totalFunc = bridge.getTotalItemStorage
    elseif cellType == "fluid" then
        usedFunc = bridge.getUsedFluidStorage
        totalFunc = bridge.getTotalFluidStorage
    elseif cellType == "chemical" then
        usedFunc = bridge.getUsedChemicalStorage
        totalFunc = bridge.getTotalChemicalStorage
    else
        return
    end

    -- used / max
    local ok, used = pcall(usedFunc, bridge)
    used = ok and used or 0
    ok, max = pcall(totalFunc, bridge)
    max = ok and max or 0

    usedTotal = used
    freeTotal = max -- Free total before removing Included Precise

    -- Details der Zellen
    if type(bridge.getCells) == "function" then
        local okCells, cells = pcall(bridge.getCells, bridge)
        if okCells and type(cells) == "table" then
            monPrint("=== " .. cellType .. " Cells ===")
            for i, cell in ipairs(cells) do
                local ctype = cell.cellType or cell.type or "nil"
                if ctype == cellType then
                    local item = cell.item or cell.name or "nil"
                    local totalBytes = cell.totalBytes or 0
                    local partitioned = cell.isPartitioned or cell.partitioned or false
                    local excluded = cell.isExcluded or cell.excluded or false
                    local precise = cell.isPrecise or cell.precise or false

                    -- Free Storage reduziert nur Included Precise
                    if precise then
                        freeTotal = freeTotal - totalBytes
                        if freeTotal < 0 then freeTotal = 0 end
                    end

                    monPrint(string.format(
                        "Cell #%d: item=%s | totalBytes=%s | Partitioned=%s | Excluded=%s | Precise=%s",
                        i, item, formatBytes(totalBytes), tostring(partitioned), tostring(excluded), tostring(precise)
                    ))
                end
            end
        end
    end

    monPrint(string.format("%s Storage: Used=%s | Free=%s", cellType, formatBytes(usedTotal), formatBytes(freeTotal)))
    monPrint("---------------------------")
end

-- Hauptschleife
while true do
    monitor.clear()
    cursorY = 1

    for _, t in ipairs(types) do
        processStorage(t)
    end

    sleep(5)
end
