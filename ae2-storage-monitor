local monitor = peripheral.find("monitor")
if not monitor then
    print("Monitor nicht gefunden!")
    print(textutils.serialize(peripheral.getNames()))
    return
end

monitor.clear()
monitor.setCursorPos(1,1)
monitor.setTextColor(colors.white)
monitor.write("Monitor funktioniert!")

local bridge = peripheral.find("me_bridge")
if not bridge then
    print("Bridge nicht gefunden!")
else
    print("Bridge gefunden!")
    print("Used Fluids: ", bridge.getUsedFluidStorage())
    print("Total Fluids: ", bridge.getTotalFluidStorage())
end
