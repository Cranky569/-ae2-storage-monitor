-- me_bridge_all_cells_monitor.lua
-- Zeigt alle Zellen von getCells() auf dem Monitor an (Items, Fluids, Chemicals)

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local _, h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
    end
    mon.setCursorPos(1, cursorY)
    mon.clearLine()
    mon.write(text)
    cursorY = cursorY + 1
end

-- Cells abrufen
local ok, cells = pcall(bridge.getCells, bridge)
if not ok then
    monPrint("Fehler beim Abrufen von Cells: " .. tostring(cells))
    return
end

if type(cells) ~= "table" or #cells == 0 then
    monPrint("Keine Cells gefunden!")
    return
end

monPrint("=== Alle Cells Debug ===")
for i, cell in ipairs(cells) do
    monPrint("Cell #" .. i)
    if type(cell) == "table" then
        for k, v in pairs(cell) do
            monPrint("  " .. tostring(k) .. " = " .. tostring(v))
        end
    else
        monPrint("  Nicht-Table Cell: " .. tostring(cell))
    end
    monPrint("----------------")
end
