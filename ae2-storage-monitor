-- Robustiertes Anzeige-Script für ME Bridge (partitioned/include precise rauslassen)
-- Debug aktiviert: Ausgaben im ComputerCraft-Terminal beginnen mit "DEBUG:"

function formatBytes(bytes)
    bytes = bytes or 0
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

local function safeCall(fn, ...)
    if type(fn) ~= "function" then return false, nil end
    local ok, res = pcall(fn, ...)
    if not ok then return false, res end
    return true, res
end

-- Filter only valid Item cells
function getFilteredItemCellBytes(bridge)
    if not bridge or type(bridge.getCells) ~= "function" then
        return safeCall(bridge.getTotalItemStorage) or 0
    end

    local ok, cells = pcall(function() return bridge.getCells() end)
    if not ok or type(cells) ~= "table" then
        return 0
    end

    local sum = 0
    for _, cell in pairs(cells) do
        local ctype = cell.cellType or cell.type
        local isPartitioned = cell.isPartitioned or false
        local isPrecise = cell.isPrecise or false
        local totalBytes = cell.totalBytes or 0

        if ctype == "item" and not (isPartitioned and isPrecise) then
            sum = sum + totalBytes
        end
    end
    return sum
end

function getItemStorage()
    local bridge = peripheral.find("me_bridge")
    if not bridge then return 0, 0 end

    local okUsed, usedItems = safeCall(bridge.getUsedItemStorage)
    usedItems = okUsed and usedItems or 0

    local maxItems = getFilteredItemCellBytes(bridge)
    return usedItems, maxItems
end

function getFluidStorage()
    local bridge = peripheral.find("me_bridge")
    if not bridge then return 0,0 end
    local okUsed, usedFluids = safeCall(bridge.getUsedFluidStorage)
    local okTotal, maxFluids = safeCall(bridge.getTotalFluidStorage)
    return (okUsed and usedFluids or 0), (okTotal and maxFluids or 0)
end

function getChemicalStorage()
    local bridge = peripheral.find("me_bridge")
    if not bridge then return 0,0 end
    local okUsed, usedGases = safeCall(bridge.getUsedChemicalStorage)
    local okTotal, maxGases = safeCall(bridge.getTotalChemicalStorage)
    return (okUsed and usedGases or 0), (okTotal and maxGases or 0)
end

function centerText(mon, text, line)
    local w,_ = mon.getSize()
    local x = math.floor((w - #text)/2)+1
    if x<1 then x=1 end
    mon.setCursorPos(x,line)
    mon.write(text)
end

function printCellsOnMonitor(mon, startLine)
    local bridge = peripheral.find("me_bridge")
    if not bridge or type(bridge.getCells)~="function" then return end

    local ok, cells = pcall(function() return bridge.getCells() end)
    if not ok or type(cells)~="table" then return end

    local line = startLine or 5
    local w,h = mon.getSize()

    mon.setTextColor(colors.white)

    for i, cell in ipairs(cells) do
        if line > h then
            -- Scroll up by one line
            mon.scroll(1)
            line = h
        end
        local name = cell.item or "<unknown>"
        local ctype = cell.cellType or cell.type or "unknown"
        local bytes = cell.totalBytes or 0
        local part = cell.isPartitioned or false
        local prec = cell.isPrecise or false
        local skip = part and prec

        mon.setCursorPos(1,line)
        mon.write(string.format("%d) %s | %s | %s | Partitioned:%s Precise:%s",
            i, name, ctype, formatBytes(bytes), tostring(part), tostring(prec)))

        line = line + 1
    end
end

function updateDisplay()
    local mon = peripheral.find("monitor")
    if not mon then
        print("No monitor found.")
        return
    end

    mon.setTextScale(1)
    mon.clear()

    while true do
        mon.setCursorPos(1,1)
        mon.setTextColor(colors.yellow)
        centerText(mon,"Item Storage",1)

        local used,max = getItemStorage()
        local free = max - used
        local percent = (max>0) and (used/max*100) or 0
        centerText(mon,string.format("Used: %s | Free: %s",formatBytes(used),formatBytes(free)),2)
        centerText(mon,string.format("%.1f%% Used",percent),3)

        mon.setTextColor(colors.cyan)
        centerText(mon,"Fluid Storage",4)
        local uF,mF = getFluidStorage()
        centerText(mon,string.format("Used: %s | Free: %s",formatBytes(uF),formatBytes(mF)),5)

        mon.setTextColor(colors.purple)
        centerText(mon,"Chemical Storage",6)
        local uC,mC = getChemicalStorage()
        centerText(mon,string.format("Used: %s | Free: %s",formatBytes(uC),formatBytes(mC)),7)

        -- Print all cells starting from line 9
        printCellsOnMonitor(mon,9)

        sleep(5)
    end
end

updateDisplay()
