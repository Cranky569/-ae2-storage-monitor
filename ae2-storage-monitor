-- chemical_cells_debug_dynamic.lua
-- Zeigt dynamisch alle Felder von Chemical Cells auf dem Monitor

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    print("Kein me_bridge gefunden!")
    return
end

mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w,h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1,cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1,cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Prüfen ob getCells verfügbar ist
if type(bridge.getCells) ~= "function" then
    monPrint("getCells() nicht verfügbar auf dieser Bridge")
    return
end

-- getCells aufrufen
local ok, cells = pcall(bridge.getCells, bridge)
if not ok then
    monPrint("Fehler beim Abrufen von Cells: " .. tostring(cells))
    return
end

if type(cells) ~= "table" then
    monPrint("getCells() hat keine Tabelle zurückgegeben")
    return
end

monPrint("=== Chemical Cells Debug ===")
for i, cell in ipairs(cells) do
    local ctype = cell.cellType or cell.type or "unknown"
    if ctype == "chemical" or ctype == "c" then
        monPrint("Cell #" .. i .. ":")
        for k,v in pairs(cell) do
            monPrint(string.format("  %s = %s", k, tostring(v)))
        end
        monPrint("-----------------------")
    end
end
