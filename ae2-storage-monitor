-- me_bridge_methods_monitor.lua
-- Zeigt wichtige Methoden der me_bridge (z.B. craftItem) auf einem Monitor

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end
if not bridge then
    mon.write("Kein me_bridge gefunden!")
    return
end

mon.setTextScale(1)
mon.setBackgroundColor(colors.black)
mon.clear()
mon.setCursorPos(1,1)

mon.write("=== ME Bridge Methoden ===")
local y = 2

-- Alle Methoden der Bridge auflisten
local methods = peripheral.getMethods(peripheral.getName(bridge))
for _, m in ipairs(methods) do
    mon.setCursorPos(1,y)
    mon.write(m)
    y = y + 1
end

-- Optional: testweise craftables anzeigen
if bridge.getCraftables then
    local ok, craftables = pcall(bridge.getCraftables)
    y = y + 1
    mon.setCursorPos(1,y)
    if ok and type(craftables) == "table" then
        mon.write("Craftables: " .. tostring(#craftables))
    else
        mon.write("getCraftables -> Fehler oder nil")
    end
end

-- Optional: CPUs anzeigen
if bridge.getCraftingCPUs then
    local ok, cpus = pcall(bridge.getCraftingCPUs)
    y = y + 1
    mon.setCursorPos(1,y)
    if ok and type(cpus) == "table" then
        mon.write("Crafting CPUs: " .. tostring(#cpus))
    else
        mon.write("getCraftingCPUs -> Fehler oder nil")
    end
end
