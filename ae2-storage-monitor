-- me_bridge_cells_monitor.lua
-- Zeigt alle Methoden der me_bridge, die "cell" enthalten, auf dem Monitor

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w,h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1,cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1,cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Alle Methoden der Bridge auflisten
local methods = peripheral.getMethods(peripheral.getName(bridge))
monPrint("=== ME Bridge Methoden (Cells) ===")
for _, m in ipairs(methods) do
    if string.find(string.lower(m), "cell") then
        monPrint("- " .. m)
    end
end

-- Optional: listCells() direkt ausgeben
if bridge.listCells then
    local ok, cells = pcall(bridge.listCells, bridge)
    if ok and type(cells) == "table" then
        monPrint("---- listCells() ----")
        for i, cell in ipairs(cells) do
            local item = cell.item or cell.name or "nil"
            local ctype = cell.cellType or cell.type or "nil"
            local totalBytes = cell.totalBytes or 0
            monPrint(string.format("Cell #%d: item=%s | type=%s | totalBytes=%d", i, item, ctype, totalBytes))
        end
    else
        monPrint("listCells() Fehler: " .. tostring(cells))
    end
else
    monPrint("listCells() nicht verfügbar")
end

monPrint("=== Ende ===")
