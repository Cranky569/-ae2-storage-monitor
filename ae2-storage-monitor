-- Function to format large numbers into a human-readable format
function formatBytes(bytes)
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

-- Function to safely call a bridge method
local function safeCall(fn, ...)
    if type(fn) ~= "function" then return false, 0 end
    local ok, res = pcall(fn, ...)
    if not ok then return false, 0 end
    return true, res or 0
end

-- Function to calculate item storage excluding Precise+Partitioned cells for Free
function getItemStorage()
    local bridge = peripheral.find("me_bridge")
    if not bridge then return 0,0 end

    local _, usedItems = safeCall(bridge.getUsedItemStorage)
    local maxItems = 0

    if type(bridge.getCells) == "function" then
        local ok, cells = pcall(bridge.getCells, bridge)
        if ok and type(cells) == "table" then
            for _, cell in pairs(cells) do
                local ctype = cell.cellType or cell.type
                local totalBytes = cell.totalBytes or 0
                local isPartitioned = cell.isPartitioned or false
                local isPrecise = cell.isPrecise or false

                if tostring(ctype) == "item" then
                    -- Nur normale Zellen fließen in Free ein
                    if not (isPartitioned and isPrecise) then
                        maxItems = maxItems + totalBytes
                    end
                end
            end
        end
    else
        -- Fallback, falls getCells nicht verfügbar
        local ok, total = safeCall(bridge.getTotalItemStorage)
        if ok then maxItems = total end
    end

    return usedItems, maxItems
end

