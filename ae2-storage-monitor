function getFluidStorage()
    local bridge = peripheral.find("me_bridge")
    if not bridge then return 0,0 end

    local _, usedFluids = safeCall(bridge.getUsedFluidStorage)
    local maxFluidsFree = 0

    if type(bridge.getCells) == "function" then
        local ok, cells = pcall(bridge.getCells, bridge)
        if ok and type(cells) == "table" then
            for _, cell in pairs(cells) do
                local ctype = cell.cellType or cell.type
                local totalBytes = cell.totalBytes or 0
                local isPrecise = cell.isPrecise or false

                if tostring(ctype) == "fluid" and not isPrecise then
                    maxFluidsFree = maxFluidsFree + totalBytes
                end
            end
        end
    else
        local ok, total = safeCall(bridge.getTotalFluidStorage)
        if ok then maxFluidsFree = total end
    end

    return usedFluids, maxFluidsFree
end

