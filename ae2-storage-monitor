-- me_bridge_cells_monitor.lua
-- Zeigt alle Zellen der me_bridge mit allen verfügbaren Infos auf dem Monitor

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w,h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1,cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1,cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Prüfen, ob getCells() verfügbar ist
if type(bridge.getCells) ~= "function" then
    monPrint("getCells() nicht verfügbar!")
    return
end

-- Alle Zellen abrufen
local ok, cells = pcall(bridge.getCells, bridge)
if not ok or type(cells) ~= "table" then
    monPrint("Fehler beim Abrufen der Zellen: " .. tostring(cells))
    return
end

monPrint("=== ME Bridge Zellen ===")
for i, cell in ipairs(cells) do
    local item = cell.item or cell.name or "nil"
    local ctype = cell.cellType or cell.type or "nil"
    local totalBytes = cell.totalBytes or 0
    local bytesPerType = cell.bytesPerType or 0
    local isPartitioned = cell.isPartitioned or false
    local isPrecise = cell.isPrecise or false

    monPrint(string.format(
        "Cell #%d: item=%s | type=%s | totalBytes=%s | bytesPerType=%s | Partitioned=%s | Precise=%s",
        i, item, ctype, totalBytes, bytesPerType, tostring(isPartitioned), tostring(isPrecise)
    ))
end

monPrint("=== Ende ===")
