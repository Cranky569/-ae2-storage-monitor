-- me_bridge_dump_to_monitor.lua
-- Gibt alle Infos der me_bridge auf einem Monitor aus (mit Auto-Scroll)

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end
if not bridge then
    print("Kein me_bridge gefunden!")
    return
end

mon.setTextScale(0.5) -- mehr Zeilen auf den Monitor kriegen
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.clear()

local monW, monH = mon.getSize()
local cursorX, cursorY = 1, 1

-- Funktion: schreibt Text auf den Monitor mit automatischem Scrollen
local function monPrint(text)
    if cursorY > monH then
        mon.scroll(1)
        cursorY = monH
        mon.setCursorPos(1, cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1, cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

monPrint("=== ME Bridge Debug Dump ===")

-- Alle Methoden listen
local methods = peripheral.getMethods(peripheral.getName(bridge)) or {}
monPrint("Methoden:")
for _, m in ipairs(methods) do
    monPrint("  - " .. m)
end

-- Cells anzeigen (falls vorhanden)
if bridge.listCells then
    local ok, cells = pcall(bridge.listCells, bridge)
    if ok and type(cells) == "table" then
        monPrint("listCells() -> " .. tostring(#cells) .. " Eintraege")
        for i, cell in ipairs(cells) do
            monPrint("Cell #" .. i)
            for k, v in pairs(cell) do
                monPrint("  " .. tostring(k) .. ": " .. tostring(v))
            end
        end
    else
        monPrint("listCells() -> Fehler: " .. tostring(cells))
    end
else
    monPrint("listCells() nicht verfuegbar.")
end

-- Craftables anzeigen (falls vorhanden)
if bridge.getCraftables then
    local ok, craftables = pcall(bridge.getCraftables)
    if ok and type(craftables) == "table" then
        monPrint("getCraftables() -> " .. tostring(#craftables) .. " Items")
        for i, craft in ipairs(craftables) do
            monPrint("  " .. tostring(craft.name or craft.label or i))
        end
    else
        monPrint("getCraftables() -> Fehler: " .. tostring(craftables))
    end
else
    monPrint("getCraftables() nicht verfuegbar.")
end

-- Crafting CPUs anzeigen (falls vorhanden)
if bridge.getCraftingCPUs then
    local ok, cpus = pcall(bridge.getCraftingCPUs)
    if ok and type(cpus) == "table" then
        monPrint("getCraftingCPUs() -> " .. tostring(#cpus) .. " CPUs")
        for i, cpu in ipairs(cpus) do
            monPrint("CPU #" .. i)
            for k, v in pairs(cpu) do
                monPrint("  " .. tostring(k) .. ": " .. tostring(v))
            end
        end
    else
        monPrint("getCraftingCPUs() -> Fehler: " .. tostring(cpus))
    end
else
    monPrint("getCraftingCPUs() nicht verfuegbar.")
end

monPrint("=== Ende ===")
