-- me_bridge_chemical_monitor.lua
-- Zeigt Chemical Storage über getChemicalStorage() auf dem Monitor an

-- Funktion zum Formatieren von Bytes
local function formatBytes(bytes)
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

-- Monitor vorbereiten
local mon = peripheral.find("monitor")
if not mon then
    print("Kein Monitor gefunden!")
    return
end

mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w, h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1, cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1, cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Chemical Storage abrufen
local bridge = peripheral.find("me_bridge")
if not bridge then
    monPrint("Kein me_bridge gefunden!")
    return
end

while true do
    mon.clear()
    cursorY = 1

    -- Chemical Storage abrufen
    local ok, used = pcall(bridge.getUsedChemicalStorage, bridge)
    local ok2, total = pcall(bridge.getTotalChemicalStorage, bridge)

    if not ok then used = 0 end
    if not ok2 then total = 0 end
    local free = total - used
    if free < 0 then free = 0 end
    local percentUsed = (total > 0) and (used / total * 100) or 0

    -- Ausgabe auf Monitor
    monPrint("=== Chemical Storage ===")
    monPrint(string.format("Used: %s | Free: %s", formatBytes(used), formatBytes(free)))
    monPrint(string.format("%.1f%% Used", percentUsed))

    sleep(5)
end
