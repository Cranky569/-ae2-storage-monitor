-- Test-Script für me_bridge.listCells()
-- Prüft, ob listCells verfügbar ist und zeigt alle Felder pro Cell an

local bridge = peripheral.find("me_bridge")

if not bridge then
    print("Kein me_bridge gefunden!")
    return
end

-- Prüfen ob listCells als Funktion existiert
if not bridge.listCells then
    print("Diese me_bridge unterstützt listCells() nicht!")
    return
end

-- Safe call auf listCells()
local ok, cells = pcall(bridge.listCells, bridge)
if not ok then
    print("Fehler bei listCells(): " .. tostring(cells))
    return
end

if not cells or type(cells) ~= "table" then
    print("listCells() hat nichts Sinnvolles zurückgegeben.")
    return
end

print("----- ME Bridge Cells -----")
for i, cell in ipairs(cells) do
    print("Cell #" .. i)
    print("  item:         " .. tostring(cell.item))
    print("  cellType:     " .. tostring(cell.cellType))
    print("  bytesPerType: " .. tostring(cell.bytesPerType))
    print("  totalBytes:   " .. tostring(cell.totalBytes))
    print("---------------------------")
end
print("----- Ende -----")
