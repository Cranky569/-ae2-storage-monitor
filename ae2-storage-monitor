-- Test-Script für me_bridge.listCells()
-- Gibt alle gefundenen Cells im Terminal aus

local bridge = peripheral.find("me_bridge")

if not bridge then
    print("Kein me_bridge gefunden!")
    return
end

if type(bridge.listCells) ~= "function" then
    print("Diese me_bridge unterstützt listCells() nicht!")
    return
end

local ok, cells = pcall(function() return bridge.listCells() end)
if not ok then
    print("Fehler bei listCells(): " .. tostring(cells))
    return
end

if not cells then
    print("listCells() hat nil zurückgegeben.")
    return
end

print("----- ME Bridge Cells -----")
print(textutils.serialize(cells))
print("----- Ende -----")
