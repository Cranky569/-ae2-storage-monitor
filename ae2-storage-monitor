-- me_bridge_cells_monitor.lua
-- Zeigt alle Cells der me_bridge auf dem Monitor an inkl. Partitioned/Precise
-- Included Precise wird nicht zum Free Storage gezählt

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w,h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1,cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1,cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Hilfsfunktion: Bytes formatieren
local function formatBytes(bytes)
    bytes = bytes or 0
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

-- Alle Cells abrufen
local ok, cells = pcall(function() return bridge.getCells() end)
if not ok or type(cells) ~= "table" then
    monPrint("Fehler: getCells() konnte nicht aufgerufen werden oder lieferte keine Tabelle")
    return
end

-- Werte für Storage
local usedItemBytes, freeItemBytes = 0, 0
local usedFluidBytes, freeFluidBytes = 0, 0
local usedChemicalBytes, freeChemicalBytes = 0, 0

-- Cells auflisten
monPrint("=== ME Bridge Cells ===")
for i, cell in ipairs(cells) do
    local item = cell.item or cell.name or "unknown"
    local ctype = cell.cellType or cell.type or cell["cell_type"] or "unknown"
    local totalBytes = cell.totalBytes or cell.bytes or cell["total_bytes"] or 0
    local partitioned = cell.isPartitioned or cell.partitioned or false
    local precise = cell.isPrecise or cell.precise or false

    -- Ausgabe auf Monitor
    monPrint(string.format(
        "Cell #%d: name=%s | type=%s | totalBytes=%s | Partitioned=%s | Precise=%s",
        i, item, tostring(ctype), formatBytes(totalBytes), tostring(partitioned), tostring(precise)
    ))

    -- Berechnung Free/Used
    if ctype == "item" then
        usedItemBytes = usedItemBytes + totalBytes
        if not (partitioned and precise) then
            freeItemBytes = freeItemBytes + totalBytes
        end
    elseif ctype == "fluid" then
        usedFluidBytes = usedFluidBytes + totalBytes
        if not (partitioned and precise) then
            freeFluidBytes = freeFluidBytes + totalBytes
        end
    elseif ctype == "chemical" then
        usedChemicalBytes = usedChemicalBytes + totalBytes
        if not (partitioned and precise) then
            freeChemicalBytes = freeChemicalBytes + totalBytes
        end
    end
end

-- Zusammenfassung
monPrint("")
monPrint(string.format("Item Storage: Used=%s | Free=%s", formatBytes(usedItemBytes), formatBytes(freeItemBytes)))
monPrint(string.format("Fluid Storage: Used=%s | Free=%s", formatBytes(usedFluidBytes), formatBytes(freeFluidBytes)))
monPrint(string.format("Chemical Storage: Used=%s | Free=%s", formatBytes(usedChemicalBytes), formatBytes(freeChemicalBytes)))
monPrint("=== Ende ===")
