-- Funktion zum Formatieren großer Zahlen
function formatBytes(bytes)
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

-- Safe call wrapper
local function safeCall(fn, ...)
    if type(fn) ~= "function" then return false, 0 end
    local ok, res = pcall(fn, ...)
    if not ok then return false, 0 end
    return true, res or 0
end

-- Berechnung Used + Free für Fluids (Free ohne Included Precise)
function getFluidStorage()
    local bridge = peripheral.find("me_bridge")
    if not bridge then return 0, 0 end

    -- Used komplett
    local _, usedFluids = safeCall(bridge.getUsedFluidStorage)

    local freeFluids = 0
    if type(bridge.getCells) == "function" then
        local ok, cells = pcall(bridge.getCells, bridge)
        if ok and type(cells) == "table" then
            for _, cell in pairs(cells) do
                local ctype = cell.cellType or cell.type
                local isPrecise = cell.isPrecise or false
                local isPartitioned = cell.isPartitioned or false
                local partitionType = cell.partitionType or "" -- "Included" oder "Excluded"

                if tostring(ctype) == "fluid" then
                    local available = 0
                    if type(cell.getAvailableBytes) == "function" then
                        local ok2, bytes = pcall(cell.getAvailableBytes, cell)
                        if ok2 and bytes then
                            available = bytes
                        end
                    else
                        -- Fallback
                        local total = cell.totalBytes or 0
                        local used = cell.usedBytes or 0
                        available = total - used
                    end

                    -- Partition + Precise Logik
                    if not (isPrecise and isPartitioned and partitionType == "Included") then
                        freeFluids = freeFluids + available
                    end
                end
            end
        end
    else
        -- Fallback
        local ok, total = safeCall(bridge.getTotalFluidStorage)
        if ok then freeFluids = total - usedFluids end
    end

    if freeFluids < 0 then freeFluids = 0 end
    return usedFluids, freeFluids
end

-- Funktion zum Zentrieren von Text
local function centerText(monitor, text, line)
    local w, _ = monitor.getSize()
    local x = math.floor((w - #text) / 2) + 1
    if x < 1 then x = 1 end
    monitor.setCursorPos(x, line)
    monitor.write(text)
end

-- Hauptanzeige für Fluids
function updateFluidMonitor()
    local monitor = peripheral.find("monitor")
    if not monitor then
        print("Monitor nicht gefunden!")
        return
    end

    monitor.setTextScale(1)
    monitor.clear()

    while true do
        monitor.clear()

        local used, free = getFluidStorage()
        local total = used + free
        local percentUsed = (total > 0) and (used / total * 100) or 0
        local percentFree = 100 - percentUsed

        monitor.setTextColor(colors.cyan)
        centerText(monitor, "Fluid Storage", 1)
        centerText(monitor, string.format("Used: %s | Free: %s", formatBytes(used), formatBytes(free)), 2)
        centerText(monitor, string.format("Total: %s | %.1f%% Used | %.1f%% Free", formatBytes(total), percentUsed, percentFree), 3)

        sleep(5)
    end
end

-- Start
updateFluidMonitor()
