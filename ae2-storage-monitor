-- me_bridge_chemical_monitor.lua
-- Zeigt Chemical Storage auf dem Monitor an, berücksichtigt Partitionen korrekt

local function formatBytes(bytes)
    if bytes >= 1000000 then
        return string.format("%.1fM", bytes / 1000000)
    elseif bytes >= 1000 then
        return string.format("%.1fK", bytes / 1000)
    else
        return tostring(bytes)
    end
end

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

-- Monitor vorbereiten
mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w,h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1,cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1,cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Berechne Chemical Storage
local usedChem = 0
local freeChem = 0
if bridge.getUsedChemicalStorage then
    usedChem = bridge.getUsedChemicalStorage()
end
if bridge.getTotalChemicalStorage then
    freeChem = bridge.getTotalChemicalStorage()
end

-- Zellen prüfen
local chemicalCells = {}
if bridge.getCells then
    local ok, cells = pcall(bridge.getCells, bridge)
    if ok and type(cells) == "table" then
        for i, cell in ipairs(cells) do
            local ctype = cell.cellType or cell.type or cell["cell_type"] or "unknown"
            if ctype == "chemical" then
                local item = cell.item or cell.name or "nil"
                local totalBytes = cell.totalBytes or cell.bytes or 0
                local partitioned = cell.isPartitioned or cell.partitioned or false
                local precise = cell.isPrecise or cell.precise or false
                local includedPrecise = cell.isIncludedPrecise or cell.includePrecise or false
                local excluded = cell.isExcluded or cell.excluded or false

                -- Free Storage anpassen: nur IncludedPrecise wird abgezogen
                if includedPrecise then
                    freeChem = freeChem - totalBytes
                    if freeChem < 0 then freeChem = 0 end
                end

                table.insert(chemicalCells, {
                    item=item,
                    totalBytes=totalBytes,
                    partitioned=partitioned,
                    precise=precise,
                    includedPrecise=includedPrecise,
                    excluded=excluded
                })
            end
        end
    else
        monPrint("Fehler beim Abrufen der Cells: " .. tostring(cells))
    end
end

-- Ergebnisse auf dem Monitor anzeigen
monPrint("=== CHEMICAL STORAGE ===")
monPrint(string.format("Used Chemicals: %s", formatBytes(usedChem)))
monPrint(string.format("Free Chemicals: %s", formatBytes(freeChem)))
monPrint("----------------------------")

-- Visualisierung der Flags für jede Cell
for i, cell in ipairs(chemicalCells) do
    monPrint(string.format("Cell #%d: %s (%s bytes)", i, cell.item, formatBytes(cell.totalBytes)))
    local flags = ""
    flags = flags .. (cell.partitioned and "[Partitioned] " or "")
    flags = flags .. (cell.precise and "[Precise] " or "")
    flags = flags .. (cell.includedPrecise and "[IncludedPrecise] " or "")
    flags = flags .. (cell.excluded and "[Excluded] " or "")
    monPrint("Flags: " .. (flags ~= "" and flags or "None"))
    monPrint("----------------------------")
end
