-- me_bridge_methods_debug.lua
-- Zeigt auf dem Monitor alle Funktionen und Felder, die getChemicalStorage (und Co.) nutzen könnte

local mon = peripheral.find("monitor")
local bridge = peripheral.find("me_bridge")

if not mon then
    print("Kein Monitor gefunden!")
    return
end

if not bridge then
    mon.clear()
    mon.setCursorPos(1,1)
    mon.write("Kein me_bridge gefunden!")
    return
end

mon.clear()
mon.setBackgroundColor(colors.black)
mon.setTextColor(colors.white)
mon.setTextScale(1)
local w, h = mon.getSize()
local cursorY = 1

local function monPrint(text)
    if cursorY > h then
        mon.scroll(1)
        cursorY = h
        mon.setCursorPos(1, cursorY)
        mon.clearLine()
    end
    mon.setCursorPos(1, cursorY)
    mon.write(text)
    cursorY = cursorY + 1
end

-- Alle Methoden der Bridge auflisten
monPrint("=== ME Bridge Methoden ===")
local methods = peripheral.getMethods(peripheral.getName(bridge))
for _, m in ipairs(methods) do
    monPrint("- " .. m)
end

-- Zeige mögliche Felder/Infos, die getChemicalStorage nutzen könnte
monPrint("=== Mögliche Felder für Chemical Storage ===")
monPrint("- isPartitioned / partitioned")
monPrint("- isPrecise / precise")
monPrint("- isIncludedPrecise / includePrecise")
monPrint("- isExcluded / excluded")
monPrint("- totalBytes / bytes")
monPrint("- cellType / type")
monPrint("- item / name")

