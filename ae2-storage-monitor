function getFilteredItemCellBytes(bridge)
    if not bridge then return 0 end

    if type(bridge.getCells) ~= "function" then
        local ok, fallback = safeCall(bridge.getTotalItemStorage)
        if ok and fallback then return fallback end
        return 0
    end

    local ok, cells = pcall(function() return bridge.getCells() end)
    if not ok or type(cells) ~= "table" then return 0 end

    local sumTotal = 0
    for i, cell in pairs(cells) do
        print("DEBUG: Cell #" .. i)
        if type(cell) == "table" then
            for k, v in pairs(cell) do
                -- nur primitive Werte oder tostring für Objekte
                local valueStr = (type(v) == "table") and "<table>" or tostring(v)
                print("  " .. tostring(k) .. ": " .. valueStr)
            end
        else
            print("  <not a table>: " .. tostring(cell))
        end

        local ctype = cell.cellType or cell.type or "unknown"
        local isPartitioned = cell.isPartitioned or false
        local isPrecise = cell.isPrecise or false
        local totalBytes = cell.totalBytes or 0

        if tostring(ctype) == "item" and not (isPartitioned and isPrecise) then
            sumTotal = sumTotal + totalBytes
        end
    end
    return sumTotal
end
