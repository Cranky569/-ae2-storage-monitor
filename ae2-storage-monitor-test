-- Function to format large numbers
local function formatBytes(bytes)
    if bytes >= 1e6 then
        return string.format("%.1fM", bytes / 1e6)
    elseif bytes >= 1e3 then
        return string.format("%.1fK", bytes / 1e3)
    else
        return tostring(bytes)
    end
end

-- Function to calculate free item storage
local function getItemStorage()
    local used, max = 0, 0
    local bridge = peripheral.find("me_bridge")
    if bridge then
        used = bridge.getUsedItemStorage()
        max = bridge.getTotalItemStorage()
    end
    return used, max
end

-- Function to calculate free fluid storage
local function getFluidStorage()
    local used, max = 0, 0
    local bridge = peripheral.find("me_bridge")
    if bridge then
        used = bridge.getUsedFluidStorage()
        max = bridge.getTotalFluidStorage()
    end
    return used, max
end

-- Function to calculate free chemical/gas storage
local function getChemicalStorage()
    local used, max = 0, 0
    local bridge = peripheral.find("me_bridge")
    if bridge then
        used = bridge.getUsedChemicalStorage()
        max = bridge.getTotalChemicalStorage()
    end
    return used, max
end

-- Function to get number of drives
local function getDriveCount()
    local bridge = peripheral.find("me_bridge")
    if bridge then
        return #bridge.listDrives()
    end
    return 0
end

-- Function to get storage per drive (for fluids and chemicals)
local function getDriveCells()
    local bridge = peripheral.find("me_bridge")
    local fluidCells, chemicalCells = 0, 0
    if bridge then
        local drives = bridge.listDrives()
        for _, drive in pairs(drives) do
            fluidCells = fluidCells + (drive.fluid or 0)
            chemicalCells = chemicalCells + (drive.chemical or 0)
        end
    end
    return fluidCells, chemicalCells
end

-- Function to center text on the monitor
local function centerText(monitor, text, line)
    local w, _ = monitor.getSize()
    local x = math.floor((w - #text) / 2) + 1
    monitor.setCursorPos(x, line)
    monitor.write(text)
end

-- Main display program
local function updateDisplay()
    local monitor = peripheral.find("monitor")
    if not monitor then
        error("No monitor found! Make sure a monitor is connected.")
    end

    monitor.setTextScale(2)
    monitor.clear()

    while true do
        monitor.clear()

        -- Drives count
        local driveCount = getDriveCount()
        centerText(monitor, "Drives: " .. driveCount, 1)
        monitor.setCursorPos(1, 2) -- empty line

        -- Item storage
        local usedItems, maxItems = getItemStorage()
        local freeItems = maxItems - usedItems
        local percentUsedItems = (maxItems > 0) and ((usedItems / maxItems) * 100) or 0
        local percentFreeItems = 100 - percentUsedItems
        monitor.setTextColor(colors.yellow)
        centerText(monitor, "Item Storage", 3)
        centerText(monitor, string.format("Used: %s | Free: %s", formatBytes(usedItems), formatBytes(freeItems)), 4)
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedItems, percentFreeItems), 5)

        -- Fluid storage
        local usedFluids, maxFluids = getFluidStorage()
        local freeFluids = maxFluids - usedFluids
        local percentUsedFluids = (maxFluids > 0) and ((usedFluids / maxFluids) * 100) or 0
        local percentFreeFluids = 100 - percentUsedFluids
        local fluidCells, chemicalCells = getDriveCells()
        monitor.setTextColor(colors.cyan)
        centerText(monitor, "Fluid Storage", 7)
        centerText(monitor, string.format("Used: %s | Free: %s | Cells: %d", formatBytes(usedFluids), formatBytes(freeFluids), fluidCells), 8)
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedFluids, percentFreeFluids), 9)

        -- Chemical/Gas storage
        local usedGases, maxGases = getChemicalStorage()
        local freeGases = maxGases - usedGases
        local percentUsedGases = (maxGases > 0) and ((usedGases / maxGases) * 100) or 0
        local percentFreeGases = 100 - percentUsedGases
        monitor.setTextColor(colors.purple)
        centerText(monitor, "Chemical Storage", 11)
        centerText(monitor, string.format("Used: %s | Free: %s | Cells: %d", formatBytes(usedGases), formatBytes(freeGases), chemicalCells), 12)
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedGases, percentFreeGases), 13)

        sleep(5) -- Refresh every 5 seconds
    end
end

-- Start the display program
updateDisplay()
