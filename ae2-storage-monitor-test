-- Funktion zur Formatierung großer Zahlen
local function formatBytes(bytes)
    if bytes >= 1e6 then
        return string.format("%.1fM", bytes / 1e6)
    elseif bytes >= 1e3 then
        return string.format("%.1fK", bytes / 1e3)
    else
        return tostring(bytes)
    end
end

-- Item Storage
local function getItemStorage()
    local used, max = 0, 0
    local bridge = peripheral.find("me_bridge")
    if bridge then
        used = bridge.getUsedItemStorage()
        max = bridge.getTotalItemStorage()
    end
    return used, max
end

