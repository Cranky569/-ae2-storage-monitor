-- Get Forge Energy Storage
local function getFEStorage()
    local used, max = 0, 0
    local bridge = peripheral.find("me_bridge")
    if bridge then
        local drives = bridge.getDrives()
        for _, drive in ipairs(drives) do
            if drive.name == "appflux:fe_qm_cell" then
                used = used + (drive.energy or 0)
                max = max + (drive.maxEnergy or 0)
            end
        end
    end
    return used, max
end

-- Get number of drives
local function getDriveCount()
    local bridge = peripheral.find("me_bridge")
    if bridge then
        local drives = bridge.getDrives()
        return #drives
    end
    return 0
end

-- Center text on the monitor
local function centerText(monitor, text, line)
    local w, _ = monitor.getSize()
    local x = math.floor((w - #text) / 2) + 1
    monitor.setCursorPos(x, line)
    monitor.write(text)
end

-- Main display program
local function updateDisplay()
    local monitor = peripheral.find("monitor")
    if not monitor then
        error("No monitor found! Make sure a monitor is connected.")
    end

    monitor.setTextScale(2)
    monitor.clear()

    while true do
        monitor.clear()
        local currentLine = 1

        -- Drives
        local driveCount = getDriveCount()
        monitor.setTextColor(colors.white)
        centerText(monitor, "Drives: " .. driveCount, currentLine)
        currentLine = currentLine + 2

        -- Item Storage
        local usedItems, maxItems = getItemStorage()
        local freeItems = maxItems - usedItems
        local percentUsedItems = (maxItems > 0) and ((usedItems / maxItems) * 100) or 0
        local percentFreeItems = 100 - percentUsedItems
        monitor.setTextColor(colors.yellow)
        centerText(monitor, "Item Storage", currentLine)
        currentLine = currentLine + 2
        centerText(monitor, string.format("Used: %s | Free: %s", formatBytes(usedItems), formatBytes(freeItems)), currentLine)
        currentLine = currentLine + 1
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedItems, percentFreeItems), currentLine)
        currentLine = currentLine + 2

        -- Fluid Storage
        local usedFluids, maxFluids = getFluidStorage()
        local freeFluids = maxFluids - usedFluids
        local percentUsedFluids = (maxFluids > 0) and ((usedFluids / maxFluids) * 100) or 0
        local percentFreeFluids = 100 - percentUsedFluids
        monitor.setTextColor(colors.cyan)
        centerText(monitor, "Fluid Storage", currentLine)
        currentLine = currentLine + 2
        centerText(monitor, string.format("Used: %s | Free: %s", formatBytes(usedFluids), formatBytes(freeFluids)), currentLine)
        currentLine = currentLine + 1
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedFluids, percentFreeFluids), currentLine)
        currentLine = currentLine + 2

        -- Chemical Storage
        local usedGases, maxGases = getChemicalStorage()
        local freeGases = maxGases - usedGases
        local percentUsedGases = (maxGases > 0) and ((usedGases / maxGases) * 100) or 0
        local percentFreeGases = 100 - percentUsedGases
        monitor.setTextColor(colors.purple)
        centerText(monitor, "Chemical Storage", currentLine)
        currentLine = currentLine + 2
        centerText(monitor, string.format("Used: %s | Free: %s", formatBytes(usedGases), formatBytes(freeGases)), currentLine)
        currentLine = currentLine + 1
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedGases, percentFreeGases), currentLine)
        currentLine = currentLine + 2

        -- Forge Energy Storage
        local usedFE, maxFE = getFEStorage()
        local freeFE = maxFE - usedFE
        local percentUsedFE = (maxFE > 0) and ((usedFE / maxFE) * 100) or 0
        local percentFreeFE = 100 - percentUsedFE
        monitor.setTextColor(colors.red)
        centerText(monitor, "Forge Energy Storage", currentLine)
        currentLine = currentLine + 2
        centerText(monitor, string.format("Used: %s | Free: %s", formatBytes(usedFE), formatBytes(freeFE)), currentLine)
        currentLine = currentLine + 1
        centerText(monitor, string.format("%.1f%% Used | %.1f%% Free", percentUsedFE, percentFreeFE), currentLine)

        sleep(5)
    end
end

updateDisplay()
